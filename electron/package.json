{
  "name": "gamecore-electron",
  "version": "1.0.0",
  "description": "GameCore — Electron shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dev": "ELECTRON_DEV=1 electron .",
    "pack": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gamecore.app",
    "productName": "GameCore",
    "win": {
      "target": "dir"
    },
    "files": ["main.js", "desktop.js", "hud.js", "power.js", "preload.js", "hud-tokens.json", "boot/**"]
  },
  "allowScripts": {
    "electron": true
  }
}
