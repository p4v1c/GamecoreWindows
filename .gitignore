# Python
__pycache__/
*.py[cod]
*.pyo
.venv
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# SQLite
*.db
*.db-journal
*.db-wal
*.db-shm

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Electron
electron/node_modules/
electron/dist/
# ROMs and Emulator Data
# The ROM tree is player data, never repository content. It used to carry a
# hand-kept skeleton of .gitkeep files, one per emulator — which had already
# drifted (no shadps4, no xenia): the installer creates the ROM directories
# from the catalogue (arch.sh, via catalog-query rom-dirs), provision_userdata
# creates emu/ itself, and rom_scanner treats a missing directory as empty.
# A second copy of "which emulators exist" is exactly the failure this
# repository keeps writing down.
emu/

# Emulator binaries and console firmwares — live on the box only,
# never in git (a branch switch must never be able to delete them).
# Anchored to the repo root: an unanchored "lib/" also swallowed
# frontend/src/lib/, silently keeping new source files out of git.
/lib/
/firmwares/

# Local backup copies (e.g. config/systems.json.bak)
*.bak

# SQLite
*.db


logs/

# OS
.DS_Store
Thumbs.db

# Secrets / env
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
*.tar.gz
*.AppImage
dist_ota/
dist_full/
/tmp/

# Qt old project build (already in GameCore/build but just in case)
GameCore/

# Installer GUI build artifacts
install/installer-gui/.buildvenv/
install/installer-gui/build/
# A .spec used to be pure build output — PyInstaller writes one next to the
# script on every CLI run. gamecore-installer.spec is a SOURCE file now: it is
# the only place able to say which libraries must stay out of the bundle, and
# ignoring it shipped the crash it exists to prevent.
install/installer-gui/*.spec
!install/installer-gui/gamecore-installer.spec

# LAN auth state — box-local, never in git (see docs/SECURITY.md)
config/auth.json
config/auth_secret
# The selected theme is per-device state: committing it would impose one
# machine's choice on every install, and an update would overwrite the
# player's. The backend treats a missing file as "default theme".
config/theme.json
# Who plays on this box: the player's own, like theme.json.
config/profiles/
# Local harness: a dev server pointed at a test backend. Never shipped.
frontend/vite.check.config.ts
frontend/preview.html
frontend/src/preview.tsx
OPUS_HANDOFF_gamepad.md

# Local gate bookkeeping — the last test counts a run observed. Box- and
# session-local state: committed once by accident, and a stale count in git
# is worse than none, since the next run compares against it.
.gate-last-count
.gate-last-skips

# Catalogue signing — the PRIVATE half, never in git, not even "for testing".
# The catalogue decides which application every box installs and launches, so
# this key is the fleet. Generate it outside the repository
# (scripts/sign-catalog.py --new-key) and keep it there; the public half in
# catalog/_ota/ is the only part that ships.
*.ed25519
*.ed25519.key
catalog-signing.key
catalog-signing*.priv
*-signing.key

# The shot harness transpiles the host's TSX keyboard to a temp module so Node
# can import it. Regenerated on every run; never edited by hand.
frontend/scripts/.kb.generated.mjs

# The default-UI darkroom's build output. `frontend/shot/` and
# `vite.shot.config.mts` are the sources and are tracked; this is what vite
# writes when they are built, and it is rebuilt on every run.
frontend/.shot-dist/

# Runtime logs, when the data root is the checkout (backend/services/logs.py)
/logs/
