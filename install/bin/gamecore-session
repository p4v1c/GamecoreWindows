"""gamecore-session: the console session. Starts the backend, then the interface, and keeps both up.

Run by the `\\GameCore\\Session` logon task: elevated, in the console user's
session, with `pythonw.exe` from the installation's venv (no console window).
Run it again (the GameCore shortcut, coming back from the Windows desktop)
and it asks the running copy to show the interface, then exits.

Stdlib only: it runs before anything else and must not depend on the backend.

    gamecore-session            start, or bring the interface back
    gamecore-session --check    print the resolved settings and exit
"""
from __future__ import annotations

import argparse
import ctypes
import logging
import os
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable

log = logging.getLogger("gamecore-session")

# Written by install/steps/write-session-env.ps1; readable by administrators only,
# since it carries the scraper credentials.
DEFAULT_ENV_FILE = Path(os.environ.get("ProgramData", r"C:\ProgramData")) / "GameCore" / "session.env"
ENV_FILE_OVERRIDE = "GAMECORE_SESSION_ENV"

# systemd's Restart=on-failure / RestartSec=5 on the Linux units, plus a slower
# pace after a burst: a console has nobody to run `systemctl reset-failed`.
RESTART_DELAY_S = 5.0
CRASH_BURST = 5
CRASH_WINDOW_S = 120.0
SLOW_RESTART_DELAY_S = 60.0
POLL_S = 1.0

# A child started with CREATE_NO_WINDOW owns a console that is never shown, and
# every console program it runs (powercfg, wevtutil, the SDL probes) inherits
# it instead of flashing a window of its own over the TV.
CREATE_NO_WINDOW = 0x08000000

MUTEX_NAME = "Local\\GameCoreSession"
SHOW_EVENT_NAME = "Local\\GameCoreSessionShowInterface"
ERROR_ALREADY_EXISTS = 183
SYNCHRONIZE_AND_MODIFY = 0x00100000 | 0x0002
LOG_CAP_BYTES = 1_000_000


class SessionError(Exception):
    """A setting the session cannot start without."""


@dataclass
class Settings:
    root: Path
    data: Path
    port: str
    env: dict[str, str]

    @property
    def logs(self) -> Path:
        return self.data / "logs" / "session"

    def backend_argv(self) -> list[str]:
        python = self.root / ".venv" / "Scripts" / "python.exe"
        return [str(python), "-m", "uvicorn", "backend.main:app",
                "--host", "127.0.0.1", "--port", self.port]

    def interface_argv(self) -> list[str]:
        return [str(self.root / "shell" / "GameCore.exe")]

    def backend_env(self) -> dict[str, str]:
        # UTF-8 mode, as every installed Python tool runs (dev log D14).
        return {**self.env, "PYTHONUTF8": "1"}

    def interface_env(self) -> dict[str, str]:
        # Unset, the shell is a checkout run by hand and starts its own backend (D24).
        return {**self.env, "GAMECORE_MANAGED": "1"}


def parse_env_file(text: str) -> dict[str, str]:
    """`KEY=value` lines; `#` comments and blank lines skipped. Values are taken raw, unquoted."""
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    return values


def load_settings(env_file: Path, base_env: dict[str, str]) -> Settings:
    """Merge the installer's file over the process environment. Raises SessionError."""
    try:
        values = parse_env_file(env_file.read_text(encoding="utf-8-sig"))
    except OSError as e:
        raise SessionError(f"cannot read {env_file}: {e.strerror or e}. "
                           "Re-run install\\install.ps1 to write it.") from e
    env = {**base_env, **values}
    missing = [k for k in ("GAMECORE_PATH", "GAMECORE_DATA") if not env.get(k)]
    if missing:
        raise SessionError(f"{env_file} does not set {', '.join(missing)}")
    env.setdefault("GAMECORE_BACKEND_PORT", "8765")
    return Settings(root=Path(env["GAMECORE_PATH"]), data=Path(env["GAMECORE_DATA"]),
                    port=env["GAMECORE_BACKEND_PORT"], env=env)


@dataclass
class Child:
    """One supervised program: what to run, and when it may run again."""
    name: str
    argv: list[str]
    env: dict[str, str]
    log_name: str
    hidden: bool
    restart_on_clean_exit: bool
    proc: object | None = None
    crashes: list[float] = field(default_factory=list)
    next_start: float = 0.0
    stopped_by_player: bool = False


Spawn = Callable[[list[str], dict[str, str], Path, Path, bool], object]


class Supervisor:
    """Keeps the backend and the interface running. Every effect is injected, so tests drive it."""

    def __init__(self, settings: Settings, spawn: Spawn,
                 clock: Callable[[], float] = time.monotonic):
        self.settings = settings
        self._spawn = spawn
        self._clock = clock
        self.backend = Child("backend", settings.backend_argv(), settings.backend_env(),
                             "backend-console.log", hidden=True, restart_on_clean_exit=True)
        self.interface = Child("interface", settings.interface_argv(), settings.interface_env(),
                               "interface-console.log", hidden=False, restart_on_clean_exit=False)

    def start(self) -> None:
        """Backend first; the interface right after, since it waits for /api/ready itself."""
        self._start(self.backend)
        self._start(self.interface)

    def show_interface(self) -> None:
        """The player came back from the desktop: start the interface unless it runs."""
        child = self.interface
        if child.proc is not None and child.proc.poll() is None:
            return
        child.stopped_by_player = False
        child.next_start = 0.0
        self._start(child)

    def tick(self) -> None:
        for child in (self.backend, self.interface):
            self._check(child)

    def _check(self, child: Child) -> None:
        now = self._clock()
        if child.proc is None:
            if not child.stopped_by_player and now >= child.next_start:
                self._start(child)
            return
        code = child.proc.poll()
        if code is None:
            return
        child.proc = None
        if code == 0 and not child.restart_on_clean_exit:
            # The shell exits 0 only when the player chose Desktop mode.
            log.info("%s exited cleanly: left to the Windows desktop", child.name)
            child.stopped_by_player = True
            return
        child.crashes = [t for t in child.crashes if now - t < CRASH_WINDOW_S] + [now]
        delay = SLOW_RESTART_DELAY_S if len(child.crashes) >= CRASH_BURST else RESTART_DELAY_S
        child.next_start = now + delay
        log.warning("%s exited with code %s; restarting in %.0f s", child.name, code, delay)

    def _start(self, child: Child) -> None:
        logs = self.settings.logs
        try:
            child.proc = self._spawn(child.argv, child.env, self.settings.root,
                                     logs / child.log_name, child.hidden)
            log.info("%s started: %s", child.name, " ".join(child.argv))
        except OSError as e:
            child.proc = None
            child.next_start = self._clock() + RESTART_DELAY_S
            log.error("%s could not start: %s", child.name, e)


def _cap(path: Path) -> None:
    """Keep one previous log: a crash trace survives one restart, the folder stays small."""
    try:
        if path.stat().st_size > LOG_CAP_BYTES:
            path.replace(path.with_suffix(path.suffix + ".1"))
    except OSError:
        pass


def spawn_process(argv: list[str], env: dict[str, str], cwd: Path, log_path: Path,
                  hidden: bool) -> subprocess.Popen:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    _cap(log_path)
    with open(log_path, "ab") as out:
        return subprocess.Popen(argv, cwd=str(cwd), env=env, stdin=subprocess.DEVNULL,
                                stdout=out, stderr=subprocess.STDOUT,
                                creationflags=CREATE_NO_WINDOW if hidden else 0)


class SingleInstance:
    """The first copy in a session owns a mutex; later copies set its "show" event and leave."""

    def __init__(self, kernel32=None):
        self._k = kernel32 or ctypes.WinDLL("kernel32", use_last_error=True)
        self._k.CreateMutexW.restype = ctypes.c_void_p
        self._k.CreateEventW.restype = ctypes.c_void_p
        self._k.OpenEventW.restype = ctypes.c_void_p
        self._mutex = None
        self._event = None

    def acquire(self) -> bool:
        self._mutex = self._k.CreateMutexW(None, False, MUTEX_NAME)
        if ctypes.get_last_error() == ERROR_ALREADY_EXISTS:
            return False
        self._event = self._k.CreateEventW(None, False, False, SHOW_EVENT_NAME)
        return True

    def ask_first_copy_to_show(self) -> bool:
        event = self._k.OpenEventW(SYNCHRONIZE_AND_MODIFY, False, SHOW_EVENT_NAME)
        if not event:
            return False
        try:
            return bool(self._k.SetEvent(ctypes.c_void_p(event)))
        finally:
            self._k.CloseHandle(ctypes.c_void_p(event))

    def show_requested(self, timeout_ms: int) -> bool:
        return self._k.WaitForSingleObject(ctypes.c_void_p(self._event), timeout_ms) == 0


def _setup_logging(settings: Settings) -> None:
    settings.logs.mkdir(parents=True, exist_ok=True)
    path = settings.logs / "session.log"
    _cap(path)
    logging.basicConfig(filename=path, encoding="utf-8", level=logging.INFO,
                        format="%(asctime)s %(levelname)s %(message)s")


def run(settings: Settings) -> int:
    instance = SingleInstance()
    if not instance.acquire():
        shown = instance.ask_first_copy_to_show()
        log.info("already running; asked it to show the interface (%s)", shown)
        return 0 if shown else 1
    supervisor = Supervisor(settings, spawn_process)
    supervisor.start()
    while True:
        if instance.show_requested(int(POLL_S * 1000)):
            supervisor.show_interface()
        supervisor.tick()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="gamecore-session", description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true", help="print the resolved settings and exit")
    args = parser.parse_args(argv)
    env_file = Path(os.environ.get(ENV_FILE_OVERRIDE) or DEFAULT_ENV_FILE)
    try:
        settings = load_settings(env_file, dict(os.environ))
    except SessionError as e:
        # pythonw has no stderr: the note next to the env file is what the owner finds.
        print(f"gamecore-session: {e}", file=sys.stderr)
        try:
            (env_file.parent / "session-error.log").write_text(f"{e}\n", encoding="utf-8")
        except OSError:
            pass
        return 2
    if args.check:
        print(f"code root  {settings.root}\ndata root  {settings.data}\nport       {settings.port}\n"
              f"backend    {' '.join(settings.backend_argv())}\n"
              f"interface  {' '.join(settings.interface_argv())}")
        return 0
    _setup_logging(settings)
    return run(settings)


if __name__ == "__main__":
    sys.exit(main())
