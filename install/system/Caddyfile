# GameCore - reverse proxy: the ONLY GameCore port exposed to the LAN.
#
# Run as-is by the GameCoreCaddy service (install/steps/install-caddy.ps1), no
# per-box templating: the site is a catch-all and certificates are minted ON
# DEMAND for whatever address the client used (LAN IP that changes when the box
# moves networks, Tailscale IP, MagicDNS name...). Every leaf chains to the same
# local root CA, so devices that installed it once keep working wherever the
# box lands.
#
# TLS: `tls internal` - Caddy's local CA signs the cert. Its files live under
# XDG_DATA_HOME, which the service sets to %ProgramData%\GameCore\caddy. Other
# devices install the root CA once from https://<ip>:8443/gc/ca.crt (link + QR
# on /login).
#
# Auth: every route except the public ones below goes through
# forward_auth -> the core's /api/auth/verify (shared login, phase 3).
# The TV never goes through Caddy (Electron -> 127.0.0.1:8765 directly).

# Only :8443 may listen on the LAN — no automatic HTTP->HTTPS redirect
# listener on :80 (one exposed GameCore port, and one firewall rule for it).
{
	auto_https disable_redirects
	# Gate for on-demand issuance. This used to ask Caddy's own admin API,
	# which answers 200 to anything — so any LAN client could open a
	# handshake with an arbitrary SNI and have the box mint a certificate
	# for it, without limit. The core approves only names that resolve to
	# this machine (see /api/auth/tls-ask).
	on_demand_tls {
		ask http://127.0.0.1:8765/api/auth/tls-ask
	}
}

https://:8443 {
	tls internal {
		on_demand
	}

	# ── Public: root CA download (bootstrap client trust) ──────────────
	handle /gc/ca.crt {
		root * {$XDG_DATA_HOME}/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/pem-certificate-chain
		header Content-Disposition "attachment; filename=gamecore-ca.crt"
		file_server
	}

	# ── Public: login page + the auth calls a logged-OUT client needs ──
	# Enumerated, not /api/auth/* — that wildcard also exposed
	# /api/auth/change-password to the whole LAN.
	@public path /login /login/* /api/auth/login /api/auth/logout /api/auth/verify
	handle @public {
		reverse_proxy 127.0.0.1:8765
	}

	# ── Public: addon registry, consumed by the shared nav bar ─────────
	handle /gc/addons {
		reverse_proxy 127.0.0.1:8765
	}

	# ── Everything else requires a valid session cookie ────────────────
	handle {
		forward_auth 127.0.0.1:8765 {
			uri /api/auth/verify
			copy_headers X-GC-User
		}

		# The core API is NEVER exposed to the LAN (only /api/auth/* above):
		# games/launch, update/apply, wifi, addons install… stay loopback-only.
		handle /api/* {
			error 403
		}

		# Addons behind path prefixes. The full path is passed through — each
		# addon strips its own prefix via root_path=ADDON_BASE (ASGI semantics;
		# a Caddy-side handle_path strip breaks Starlette sub-mounts like
		# save-manager's /tools). Trailing slash matters: relative URLs need
		# /roms to land on /roms/.
		redir /roms /roms/ 308
		redir /saves /saves/ 308
		redir /rpcs3 /rpcs3/ 308
		redir /bios /bios/ 308
		redir /twitch /twitch/ 308
		handle /roms/* {
			reverse_proxy 127.0.0.1:8770
		}
		handle /saves/* {
			reverse_proxy 127.0.0.1:8772
		}
		handle /rpcs3/* {
			reverse_proxy 127.0.0.1:8771
		}
		handle /bios/* {
			reverse_proxy 127.0.0.1:8773
		}

		# EmberTV. It used to listen on 0.0.0.0:8097 with no auth at all, which
		# meant any device on the Wi-Fi could post to Twitch as the owner — the
		# one GameCore port on the LAN rule exists precisely to stop that. It is
		# loopback-only now and reachable here instead, behind the same login.
		# Same no-strip contract as the addons: EmberTV takes BASE_PATH=/twitch
		# (set by its pack) and strips the prefix itself.
		# The TV does not come through here — its kiosk opens localhost:8097.
		# start-tv.sh hands EmberTV a self-signed cert, so this hop speaks HTTPS;
		# skip verification on it, the connection never leaves loopback.
		#
		# header_up Host is not optional here. With an https:// upstream Caddy
		# replaces Host with the upstream address (it leaves it alone for a plain
		# http:// one), and EmberTV's CSRF guard accepts a POST only when the
		# Origin host equals Host — so without this, sending a chat message or
		# signing out from a LAN browser would 403 every time.
		handle /twitch/* {
			reverse_proxy https://127.0.0.1:8097 {
				transport http {
					tls
					tls_insecure_skip_verify
				}
				header_up Host {hostport}
			}
		}

		# The TV SPA is not usable over the LAN (its /api is blocked) —
		# land on the ROM manager instead.
		redir / /roms/ 302

		# Core statics used by the addon pages (/assets/*, /covers/*).
		handle {
			reverse_proxy 127.0.0.1:8765
		}
	}
}
