[
  {
    "id": "steam",
    "kind": "app",
    "type": "application",
    "label": "Steam",
    "platform": "Steam",
    "color": "#1f6fb3",
    "iconPath": "assets/logos/steam.png",
    "path": "@GAMECORE_PATH@/python/tools/python.exe",
    "args": "'@GAMECORE_PATH@/catalog/steam/files/steam_session.py' -gamepadui"
  },
  {
    "id": "youtube",
    "kind": "app",
    "type": "application",
    "label": "YouTube",
    "platform": "Web",
    "color": "#ff0000",
    "iconPath": "assets/logos/youtube.png",
    "path": "firefox",
    "args": "--profile '@HOME@/.mozilla/firefox/youtube-tv' --kiosk 'https://www.youtube.com/tv' "
  },
  {
    "id": "twitch",
    "kind": "app",
    "type": "application",
    "label": "Twitch",
    "platform": "Web",
    "color": "#800080",
    "iconPath": "assets/logos/twitch.png",
    "path": "firefox",
    "args": "--profile '@HOME@/.mozilla/firefox/twitch-tv' --kiosk 'https://localhost:8097/' "
  },
  {
    "id": "stremio",
    "kind": "app",
    "type": "application",
    "label": "Stremio",
    "platform": "Media",
    "color": "#8a5fff",
    "iconPath": "assets/logos/stremio.png",
    "path": "bash",
    "args": "/opt/Stremio/stremio-tv.sh",
    "fullscreen": {
      "wm_class": [
        "stremio",
        "Stremio",
        "com.stremio.Stremio"
      ],
      "timeout_s": 60
    },
    "gamepadTrigger": true
  }
]
