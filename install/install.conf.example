# install.conf - everything install\install.ps1 -Unattended needs.
#   .\install\install.ps1 -ConfigFile install.conf -Unattended
# KEY=value, one per line; quote a value that holds spaces or a '#'.
# This file holds secrets in clear text: keep it out of git and delete it once
# the install is done.

# The Windows account GameCore runs in: signed in automatically, the logon task
# runs as it. Default: the account running the installer.
#USER_NAME=pavic

# Where the code goes (read-only for the player). Default: C:\Program Files\GameCore
#GAMECORE_PATH=C:\Program Files\GameCore

# Where the player's data lives: ROMs, saves, covers, config. Default:
# <Documents of USER_NAME>\GameCore. Another NTFS volume works too. Avoid a
# folder OneDrive syncs: ROMs and saves would upload.
#GAMECORE_DATA=D:\GameCoreData

# The backend's port on 127.0.0.1, and the LAN port Caddy serves (HTTPS).
WEB_PORT=8765
LAN_PORT=8443

# 1 = sign USER_NAME in automatically at boot. Its password is never read from
# this file: an unattended install skips it and says to run
#   .\install\install.ps1 -Only configure-autologon
# at the PC, which asks for it and stores it as an LSA secret.
AUTOLOGON=1

# 1 = install and start OpenSSH Server, reachable from private networks only.
SSH=1

# 1 = build the offline metadata index (LaunchBox dump, 234 MB download):
# titles, synopses and covers with no account. 0 = skip; build it later with
#   .\install\install.ps1 -Only build-media-index
MEDIA_INDEX=1

# Optional API keys - leave empty to skip.
TGDB_API_KEY=''

# ScreenScraper - box art, 3D boxes, screenshots, videos and synopses, matched
# by file hash rather than by filename. Leave empty to skip: covers then resolve
# from the embedded icon, GameTDB and libretro.
#
# TWO levels, both required, and they are not the same account:
#   developer - granted per software on the ScreenScraper forum. SS_DEV_ID is
#               the developer PSEUDONYM, not the number in the devinfos.php URL.
#   member    - your own screenscraper.fr account. It carries the daily quota
#               and the number of threads allowed.
#
# The installer writes them to %ProgramData%\GameCore\session.env, readable by
# administrators only.
SS_DEV_ID=''
SS_DEV_PASSWORD=''
SS_USER=''
SS_PASSWORD=''

# Web login password, required for web access from the LAN. Empty = asked
# during an interactive install; an unattended one leaves web access locked.
WEB_PASSWORD=''
